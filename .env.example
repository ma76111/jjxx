# ================================================================
# Referral Bot Configuration (Root)
# انسخ هذا الملف إلى .env وعدل القيم
# ================================================================

# Telegram Bot Token (احصل عليه من @BotFather)
BOT_TOKEN=your_bot_token_here

# Bot Username (بدون @)
BOT_NAME=your_bot_name

# Admin IDs (افصل بفاصلة)
ADMIN_IDS=123456789,987654321

# Main Admin ID
MAIN_ADMIN_ID=123456789

# Database Path
DATABASE_PATH=./bot.db

# Binance API (اختياري - للتحقق التلقائي من TXID)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# GitHub Backup (اختياري - للنسخ الاحتياطي)
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=username/repo
