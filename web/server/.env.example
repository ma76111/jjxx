# ================================================================
# Web Server Configuration
# انسخ هذا الملف إلى .env وعدل القيم
# ================================================================

# Telegram Bot Token (نفس token البوت)
BOT_TOKEN=your_bot_token_here

# Bot Username
BOT_NAME=your_bot_name

# JWT Secret (استخدم سلسلة عشوائية قوية!)
# يمكنك توليدها بـ: openssl rand -base64 32
JWT_SECRET=change_this_to_a_very_long_random_string_at_least_32_characters

# Server Port
WEB_PORT=3001

# Client Origin (للـ CORS)
CLIENT_ORIGIN=http://localhost:5173

# Main Admin ID
MAIN_ADMIN_ID=123456789
